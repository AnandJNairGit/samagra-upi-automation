# ==============================================================================
# Samagra UPI Automation - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# Never commit real credentials or production secrets to version control.

# Application
APP_ENV=development
APP_NAME=samagra-upi-automation
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Localhost PostgreSQL port mapping (e.g. 5435 to avoid conflicting with local Postgres on 5432/5433)
POSTGRES_HOST_PORT=5435

# PostgreSQL Database Configuration
POSTGRES_DB=training_payments
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me_to_a_secure_password
PGDATA=/var/lib/postgresql/data/pgdata
DATABASE_URL=postgresql+asyncpg://app_user:change_me_to_a_secure_password@postgres:5432/training_payments

# CORS Configuration
# In production, browser requests are same-origin via host Caddy (/upi/* -> /upi-api/*)
# and CORS can remain empty. Set origins for local cross-origin development if needed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication & JWT Configuration
# In production, set JWT_SECRET_KEY to a cryptographically strong secret (min 32 chars).
JWT_SECRET_KEY=change_me_to_a_secure_jwt_secret_key_minimum_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_NAME=samagra_refresh
# AUTH_COOKIE_SECURE=true  # Defaults to true in production (requires HTTPS)
AUTH_COOKIE_SAMESITE=lax

# Development Seed Credentials (Do NOT set in production)
DEV_ADMIN_PASSWORD=change_me_dev_password_123

# Frontend Environment Variables (Injected at build/run time)
VITE_BASE_PATH=/upi/
VITE_API_BASE_URL=/upi-api
